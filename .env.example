# ── Supabase (필수) ────────────────────────────────────────────────
# Supabase 프로젝트 > Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 서버 전용 키. 절대 클라이언트에 노출 금지 (관리 작업/시드용)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── 앱 설정 ────────────────────────────────────────────────────────
# 비밀번호 재설정 등 콜백 URL 생성에 사용
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI (선택) ──────────────────────────────────────────────────────
# 없으면 AI 항목 추출 기능이 우아하게 비활성화됩니다(앱은 정상 동작).
# AI는 견적 "항목 추출"에만 사용하며 금액 판단에는 절대 쓰지 않습니다.
# 모델: Haiku 4.5 고정, 저신뢰/실패 시에만 Sonnet 4.6 1회 폴백.
ANTHROPIC_API_KEY=

# AI 원가 추정 환율(USD→KRW). 미설정 시 1400. (마진 보호용 ai_usage 적재에 사용)
AI_USD_KRW=

# ── 구독 결제 / PortOne (선택) ────────────────────────────────────
# 없으면 결제 기능이 "준비 중"으로 비활성화됩니다(앱은 정상 동작).
# 빌링키 정기결제. 활성화하려면 SUPABASE_SERVICE_ROLE_KEY 도 함께 필요(쓰기는 서비스 역할).
# PortOne 콘솔 > 결제연동 / API Keys 에서 확인.
PORTONE_API_SECRET=
# Standard Webhooks 서명 시크릿(whsec_ 접두사 포함). 웹훅 무결성 검증용.
PORTONE_WEBHOOK_SECRET=
# 브라우저 SDK(빌링키 발급)용 공개 식별자. 클라이언트에 노출됨.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=

# ── 크론 / 연체 알림 (선택) ───────────────────────────────────────
# 연체 수금 알림 크론(/api/cron/overdue) 호출 인증용.
# Vercel Cron 은 이 값을 Authorization: Bearer 헤더로 자동 전송한다.
# 없으면 크론 라우트가 503 으로 비활성된다. (SUPABASE_SERVICE_ROLE_KEY 도 필요)
CRON_SECRET=
